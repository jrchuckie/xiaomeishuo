{
  "name": "xiaomeishuo-local-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:spa",
    "build:spa": "tsc -b tsconfig.spa.json && vite --config vite.spa.config.ts build",
    "build:site": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b tsconfig.spa.json --pretty false"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.3",
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "idb-keyval": "^6.2.2",
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/node": "22.19.19",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "^5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vite-plugin-pwa": "^1.1.0",
    "wrangler": "4.92.0"
  }
}
